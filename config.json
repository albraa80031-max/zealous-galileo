{
  "legal_agent": {
    "name": "Legal Agent - نظام إدارة البيانات القانونية",
    "version": "1.0.0",
    "description": "نظام متكامل لإدارة البيانات القانونية والعقود والقضايا مع تكامل GitHub",
    "author": "Legal Agent Team",
    "created_at": "2026-08-20"
  },
  "github_integration": {
    "enabled": true,
    "auto_sync": true,
    "sync_interval": 3600,
    "retry_attempts": 3,
    "timeout": 30
  },
  "data_management": {
    "storage_type": "json",
    "auto_backup": true,
    "backup_interval": 86400,
    "version_control": true
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "logs/legal_agent.log",
    "max_file_size": 10485760,
    "backup_count": 5
  },
  "security": {
    "encrypt_sensitive_data": true,
    "ssl_verify": true,
    "rate_limiting": true
  }
}
